# Copy to .env and fill in real values. Never commit .env.

# Session/JWT signing secret (portal auth). Any long random string.
JWT_SECRET=

# MySQL connection string for the app database.
DATABASE_URL=

# Anthropic API key, used by the AI Interview Coach.
ANTHROPIC_API_KEY=

# Pipedrive API token, used to create Persons/Deals/Notes for new enquiries.
PIPEDRIVE_API_TOKEN=

# Comma-separated list of staff emails to notify on new enquiries.
# Falls back to a built-in default list (see server/_core/env.ts) if unset.
STAFF_NOTIFY_EMAILS=

# Public base URL of the site, used to build links in emails (e.g. portal
# setup links). Falls back to https://$RAILWAY_PUBLIC_DOMAIN in production,
# or http://localhost:3000 in development, if unset.
PUBLIC_SITE_URL=

# Microsoft Graph app-only (client-credentials) credentials, used to send
# staff/applicant notification emails. Requires the Azure AD app to have
# Mail.Send application permission granted with admin consent.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mailbox notification emails are sent as, via Microsoft Graph. Defaults to
# tim.hunt@worldstudentadvisors.com if unset — consider a shared/non-personal
# mailbox instead, since Exchange won't deliver a copy back to a mailbox's
# own Inbox when it's also the sender.
MICROSOFT_SEND_AS_MAILBOX=

# Google OAuth credentials for Student Portal "Sign in with Google".
# Create an OAuth 2.0 Client ID in Google Cloud Console → APIs & Services →
# Credentials. Add your domain's /api/portal/auth/google/callback as an
# authorised redirect URI. Keep both values server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
