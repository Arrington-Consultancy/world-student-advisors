# Copy to .env and fill in real values. Never commit .env.

# Session/JWT signing secret (portal auth). Any long random string.
JWT_SECRET=

# MySQL connection string for the app database.
DATABASE_URL=

# Anthropic API key, used by the AI Interview Coach.
ANTHROPIC_API_KEY=

# Pipedrive API token, used to create Persons/Deals/Notes for new enquiries.
PIPEDRIVE_API_TOKEN=

# Comma-separated list of staff emails to notify on new enquiries.
# Falls back to a built-in default list (see server/_core/env.ts) if unset.
STAFF_NOTIFY_EMAILS=

# Public base URL of the site, used to build links in emails (e.g. portal
# setup links). Falls back to https://$RAILWAY_PUBLIC_DOMAIN in production,
# or http://localhost:3000 in development, if unset.
PUBLIC_SITE_URL=

# Microsoft Graph app-only (client-credentials) credentials, used to send
# staff/applicant notification emails. Requires the Azure AD app to have
# Mail.Send application permission granted with admin consent.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mailbox notification emails are sent as, via Microsoft Graph. Defaults to
# tim.hunt@worldstudentadvisors.com if unset — consider a shared/non-personal
# mailbox instead, since Exchange won't deliver a copy back to a mailbox's
# own Inbox when it's also the sender.
MICROSOFT_SEND_AS_MAILBOX=

# Google OAuth credentials for Student Portal "Sign in with Google".
# Create an OAuth 2.0 Client ID in Google Cloud Console → APIs & Services →
# Credentials. Add your domain's /api/portal/auth/google/callback as an
# authorised redirect URI. Keep both values server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bcrypt hash of the Staff Portal shared password (never the plaintext
# password itself). Generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "the-password"
# Leave unset to keep the Staff Portal inaccessible.
STAFF_PORTAL_PASSWORD_HASH=

# Google Ads Qualified Lead conversions (Data Manager API), the WSA-owned
# replacement for the Zapier automation. Preferred: a Google Cloud service
# account key whose email has been given access to Google Ads customer
# 516-583-8785, with the Data Manager API enabled on its Cloud project.
# Paste the key file's JSON as one line. Server-only; never logged.
GOOGLE_ADS_DATAMANAGER_SERVICE_ACCOUNT_JSON=
# Alternative when Google Ads will not accept a service account as a user:
# an OAuth client and a refresh token minted by a Google account with access
# to the Google Ads account, scope https://www.googleapis.com/auth/datamanager.
GOOGLE_ADS_DATAMANAGER_OAUTH_CLIENT_ID=
GOOGLE_ADS_DATAMANAGER_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DATAMANAGER_OAUTH_REFRESH_TOKEN=
# Defaults are the live WSA account and its Qualified Lead conversion action
# (customers/5165838785/conversionActions/7726096949). Override only for a
# test account. Set the login customer id only if access is via a manager.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_QUALIFIED_LEAD_CONVERSION_ACTION_ID=
GOOGLE_ADS_QUALIFIED_LEAD_SYNC_MINUTES=15
# The explicit enable switch for the Qualified Lead sync. The sync sends
# nothing, however complete the credential and configuration above are,
# unless this is exactly "true". Leave it unset while the Google credential
# is being installed and checked; set it only once the historical Deals in
# the 30-day window have been decided on.
GOOGLE_ADS_QUALIFIED_LEAD_SYNC_ENABLED=
